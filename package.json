{
  "name": "mega-route",
  "version": "3.1.2",
  "description": "Keeps a two-way sync between an Obsidian vault and a MEGA folder, run by MEGA's own command-line tool MEGAcmd.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/setup.ts --test \"tests/*.test.ts\"",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint --max-warnings=0 src"
  },
  "keywords": [
    "obsidian",
    "mega",
    "megacmd",
    "sync"
  ],
  "author": "Gameboard-dev",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.23.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.8.7",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.72.1"
  },
  "type": "module"
}
